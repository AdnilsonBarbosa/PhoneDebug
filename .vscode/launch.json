{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "CLI (watch)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/PhoneDebug.Cli/bin/Debug/net9.0/phone-debug.dll",
            "args": [],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "stopAtEntry": false
        },
        {
            "name": "CLI (devices)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/PhoneDebug.Cli/bin/Debug/net9.0/phone-debug.dll",
            "args": ["devices"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "stopAtEntry": false
        },
        {
            "name": "CLI (custom args...)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/PhoneDebug.Cli/bin/Debug/net9.0/phone-debug.dll",
            "args": ["${input:cliArgs}"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "stopAtEntry": false
        },
        {
            "name": "Windows app",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/PhoneDebug.App/bin/Debug/net9.0-windows/PhoneDebug.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "console": "internalConsole",
            "stopAtEntry": false
        }
    ],
    "inputs": [
        {
            "id": "cliArgs",
            "type": "promptString",
            "description": "phone-debug arguments",
            "default": "info"
        }
    ]
}
